rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Vendor listings: anyone can read (public search).
    // Any signed-in user can create a listing (it becomes theirs).
    // Unauthenticated visitors can also create a listing ONLY through the
    // public register.html self-registration flow — see the third
    // create branch below.
    // A listing can be edited/deleted by its owner, by an admin,
    // or claimed by a signed-in user who supplies the correct claimCode
    // on a currently-unclaimed (ownerId == null) listing.
    match /vendors/{vendorId} {
      allow read: if true;

      allow create: if request.auth != null && (
        request.resource.data.ownerId == request.auth.uid ||
        (isAdmin() && request.resource.data.ownerId == null)
      ) || (
        // Public self-registration from register.html — no auth required,
        // since that form doesn't have a sign-in step. Tightly scoped: must
        // look exactly like a fresh, unclaimed, direct-registration doc —
        // not just "ownerId == null" (that alone would also cover
        // admin-added listings and let anyone forge those).
        request.resource.data.ownerId == null &&
        request.resource.data.source == 'direct-registration' &&
        request.resource.data.claimCode is string &&
        request.resource.data.claimCode.size() == 6 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time
      );

      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        (
          resource.data.ownerId == null &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.claimCode == resource.data.claimCode &&
          // If this listing came with an ownerEmail (i.e. it was
          // self-registered via register.html), only the matching Gmail/
          // email account may claim it — not just anyone with the code.
          // Listings without an ownerEmail (e.g. admin-added) skip this
          // check, since there's nothing on file to match against.
          (
            !('ownerEmail' in resource.data) ||
            request.auth.token.email.lower() == resource.data.ownerEmail.lower()
          )
        )
      ) || (
        // Anyone — including anonymous browsers — can bump interaction
        // counters (view/call/whatsapp/directions) to power analytics and
        // social proof. This must work without sign-in, since customers
        // browsing Stall don't need an account. The affectedKeys() check
        // is what keeps this safe: it only ever touches these four
        // counter fields and nothing else on the listing.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount', 'callCount', 'whatsappCount', 'directionsCount'])
      ) || (
        // Public rating/phone auto-refresh (see src/ratingSync.js). This
        // is intentionally allowed for ANYONE, signed in or not, since
        // it runs from the public Find page — but only these four
        // fields can change, only within sane value ranges, and only
        // when the stored ratingUpdatedAt is missing or actually stale.
        // That staleness check is the real cost control: it caps writes
        // (and the Google API call behind them) to once per listing per
        // window, no matter how many visitors hit the page — keep the
        // 24h figure here in sync with RATING_STALE_HOURS in constants.js.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingsCount', 'phone', 'ratingUpdatedAt']) &&
        (request.resource.data.rating == null ||
          (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5)) &&
        (request.resource.data.ratingsCount == null ||
          (request.resource.data.ratingsCount is number && request.resource.data.ratingsCount >= 0)) &&
        (
          !('ratingUpdatedAt' in resource.data) ||
          request.time > resource.data.ratingUpdatedAt + duration.value(24, 'h')
        )
      );

      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());

      // Reviews left by any signed-in user. One review per user per
      // vendor, enforced by using the reviewer's own UID as the doc ID —
      // submitting again just edits their existing review instead of
      // creating a second one.
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || isAdmin());
      }

      // Raw interaction events (view/call/whatsapp/directions), used to
      // compute real time-windowed counts (e.g. "recent" views) rather
      // than a misleading all-time number. Write-only for clients —
      // nobody, including the vendor themselves, reads individual event
      // rows; only admins can read them (e.g. for abuse investigation).
      // Anonymous writes are allowed for the same reason as the counter
      // update above: customers browsing shouldn't need an account.
      match /events/{eventId} {
        allow create: if request.resource.data.type in ['view', 'call', 'whatsapp', 'directions'];
        allow read: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Admin membership list. Documents here are added manually via the
    // Firebase Console (doc ID = the admin's Firebase Auth UID).
    // No client can write to this collection.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Reports (dispute a listing). Anyone signed in or anonymous can file
    // one — that's deliberate, requiring an account to report something
    // wrong would just suppress reports. Nobody but admins can read or
    // resolve them; a report is never publicly visible and never affects
    // the listing on its own.
    match /reports/{reportId} {
      allow create: if request.resource.data.status == 'open';
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Favorites: fully private to each user. A user can only read/write
    // their own favorites subcollection, never anyone else's.
    match /users/{uid} {
      match /favorites/{vendorId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Weekly digests (see digestFunctions.js). Written only by Cloud
    // Functions via the Admin SDK, which bypasses these rules entirely —
    // so "write: if false" here just blocks any *client* from forging
    // their own digest. Reading and marking-as-read stays client-side.
    match /digests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /vendor_digests/{vendorId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Premium subscription status. Normally written only by Cloud
    // Functions (createSubscription / verifySubscription / razorpayWebhook)
    // via the Admin SDK. Admins can ALSO write directly from the admin
    // panel to manually grant/revoke premium (comps, pilots, support
    // fixes) — everyone else still has no write path at all.
    //
    // Caution baked into the admin UI, not the rule itself: revoking a
    // vendor who has an actual live Razorpay subscription just flips
    // isPremium off locally — it doesn't cancel their subscription, so
    // the next successful webhook charge will silently turn it back on.
    // Manual revokes are meant for admin-granted premium, not real payers.
    match /premium_vendors/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Google Business Profile connection. Most fields (accessToken,
    // refreshToken, tokenExpiresAt, accountName, locationName, locationId,
    // connected, connectedAt, lastPolled) are written only by the
    // oauthCallback Cloud Function via the Admin SDK — these must never
    // be client-writable since they include OAuth tokens.
    //
    // Two client-side actions are legitimate though (see
    // ReviewAutoResponder.jsx): disconnecting (sets connected: false +
    // disconnectedAt) and saving response settings (responseSettings +
    // settingsUpdatedAt). affectedKeys().hasOnly(...) restricts the owner
    // to exactly those fields — trying to write anything else (like
    // forging their own accessToken) is denied.
    match /gbp_connections/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['connected', 'disconnectedAt', 'responseSettings', 'settingsUpdatedAt']);
    }

    // Internal bookkeeping for weeklyVendorDigest's week-over-week
    // comparison — never read by any client, only by the Cloud Function
    // itself (Admin SDK, bypasses rules).
    match /vendor_counter_snapshots/{vendorId} {
      allow read, write: if false;
    }

    // Vendor Boost health score + checklist. Written only by the
    // runBoostScan Cloud Function via the Admin SDK, which bypasses
    // these rules — "write: if false" here just blocks a client from
    // forging its own score. Only the listing's owner (or an admin)
    // can read it, same pattern as vendor_digests above.
    match /vendors/{vendorId}/boost/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }
  }
}
